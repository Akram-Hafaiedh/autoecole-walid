# Copy this file to .env and fill it in. Never commit .env.

# Supabase or Neon: use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Login (Better Auth). Generate the secret with: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=""
# The address of the site: http://localhost:3000 locally, the real address on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# The admin account is not an environment variable: create it with
#   npm run auth:create-admin
