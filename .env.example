# Copy this file to .env and fill it in. Never commit .env.

# Supabase or Neon: use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# The only address that can log in. The login code is sent here.
ADMIN_EMAIL="owner@example.com"

# Random string of 32+ characters. Generate one with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=""

# Resend (https://resend.com), used to email the login code.
# Leave RESEND_API_KEY empty in development: the code is printed in the terminal instead.
RESEND_API_KEY=""
# Until you verify a domain in Resend, "onboarding@resend.dev" can only send to the
# email address of your own Resend account. Once a domain is verified, use e.g.
# MAIL_FROM="Auto-École Walid <connexion@your-domain.com>"
MAIL_FROM=""
