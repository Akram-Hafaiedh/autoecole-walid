// Auto-École Walid: v1 data model.
//
// Prisma cannot express "no overlapping lessons" or "driving lessons need a car".
// Those rules live in prisma/constraints.sql, which you append to the first
// migration (see README, section "Database").

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection string is set in prisma.config.ts.
}

enum StudentStatus {
  active
  paused
  completed
  archived

  @@map("student_status")
}

enum LessonKind {
  driving
  code
  exam
  /// Refresher lessons for someone who already has a licence but has not driven for a long time.
  refresher

  @@map("lesson_kind")
}

enum LessonStatus {
  scheduled
  completed
  cancelled
  no_show

  @@map("lesson_status")
}

enum PriceMode {
  per_session
  per_hour

  @@map("price_mode")
}

/// Where a lesson's billed amount came from (see lib/billing.ts).
enum ChargeSource {
  standard
  student
  custom
  package
  absence

  @@map("charge_source")
}

enum PaymentMethod {
  cash
  transfer
  cheque
  other

  @@map("payment_method")
}

enum DiscountKind {
  percent
  fixed

  @@map("discount_kind")
}

enum Transmission {
  manual
  automatic

  @@map("transmission")
}

model Student {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  phone           String?
  email           String?
  birthDate       DateTime?     @map("birth_date") @db.Date
  /// Sensitive: only ever read inside the admin.
  nationalId      String?       @map("national_id")
  licenceCategory String        @default("B") @map("licence_category")
  status          StudentStatus @default(active)
  notes           String?
  /// A total price agreed for everything (a "forfait"), in millimes. Their lessons are then included.
  packageTotal    Int?          @map("package_total")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons   Lesson[]
  rates     StudentRate[]
  discounts StudentDiscount[]
  payments  Payment[]

  @@map("students")
}

model Instructor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String?
  email      String?
  active     Boolean  @default(true)
  /// Link to the login account once auth exists.
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@map("instructors")
}

model Car {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// For example "Clio blanche".
  label           String
  plate           String       @unique
  transmission    Transmission @default(manual)
  active          Boolean      @default(true)
  nextServiceDate DateTime?    @map("next_service_date") @db.Date
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@map("cars")
}

// Login. These five models are the ones Better Auth needs (https://better-auth.com).
// Only the table and column names are ours; the field names must stay as they are.

/// Someone who can log in to the admin.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// "user" cannot open the dashboard; "admin" can. Set by npm run auth:create-admin.
  role          String    @default("user")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// How a user signs in: "credential" holds the password hash; Google would be another row.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Counts requests per IP address, to slow down password guessing.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Lesson {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  instructorId    String        @map("instructor_id") @db.Uuid
  /// Null for code lessons. Required for driving and refresher lessons (checked in constraints.sql).
  carId           String?       @map("car_id") @db.Uuid
  kind            LessonKind    @default(driving)
  status          LessonStatus  @default(scheduled)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  notes           String?
  /// A price set on this one lesson. Both are set together, or both are empty.
  customPriceMode PriceMode?    @map("custom_price_mode")
  /// In millimes: per session, or per hour.
  customPrice     Int?          @map("custom_price")
  /// What the lesson is billed, in millimes. Set when it is marked done or absent, then kept.
  amount          Int?
  chargeSource    ChargeSource? @map("charge_source")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    Student    @relation(fields: [studentId], references: [id])
  instructor Instructor @relation(fields: [instructorId], references: [id])
  car        Car?       @relation(fields: [carId], references: [id])

  @@index([startsAt])
  @@map("lessons")
}

/// The school's standard price for one kind of lesson. One row per kind; no row means no price yet.
model Rate {
  kind       LessonKind @id
  mode       PriceMode
  /// Millimes: per session, or per hour.
  amount     Int
  /// Charged when the student does not show up. 0 means nothing.
  absenceFee Int        @default(0) @map("absence_fee")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rates")
}

/// A price agreed with one student for one kind of lesson. Beats the standard price.
model StudentRate {
  studentId String     @map("student_id") @db.Uuid
  kind      LessonKind
  mode      PriceMode
  amount    Int
  student   Student    @relation(fields: [studentId], references: [id])

  @@id([studentId, kind])
  @@map("student_rates")
}

/// A discount the school offers, for example "Réseaux sociaux" or "Fêtes".
model Discount {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  kind      DiscountKind
  /// A percentage from 1 to 100, or an amount in millimes.
  value     Int
  active    Boolean      @default(true)
  /// Optional window in which it can be given, for a holiday offer.
  validFrom DateTime?    @map("valid_from") @db.Date
  validTo   DateTime?    @map("valid_to") @db.Date
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  given StudentDiscount[]

  @@map("discounts")
}

/// A discount given to a student. The name and value are copied, so editing the offer later
/// does not change what the student was promised.
model StudentDiscount {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  discountId String?      @map("discount_id") @db.Uuid
  label      String
  kind       DiscountKind
  value      Int
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the discount is taken back. The row stays, for the record.
  voidedAt   DateTime?    @map("voided_at") @db.Timestamptz(6)

  student  Student   @relation(fields: [studentId], references: [id])
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_discounts")
}

/// Money received from a student. Never deleted: a mistake is cancelled (voidedAt) and re-entered.
model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String        @map("student_id") @db.Uuid
  /// Millimes, always more than 0.
  amount    Int
  paidOn    DateTime      @map("paid_on") @db.Date
  method    PaymentMethod @default(cash)
  note      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt  DateTime?     @map("voided_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, paidOn])
  @@map("payments")
}

/// Where a request from the public contact form stands. The owner moves it along.
enum ProspectStatus {
  received
  contacted
  enrolled
  closed

  @@map("prospect_status")
}

/// A request sent from the public site's contact form: someone who may become a student.
model Prospect {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  phone      String
  email      String?
  /// An offer id from lib/site.ts (code, conduite or complet), or empty.
  interest   String?
  message    String?
  status     ProspectStatus @default(received)
  /// Set when the owner puts the request away. It keeps its status and can be restored.
  archivedAt DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("prospects")
}
