// Auto-École Walid: v1 data model.
//
// Prisma cannot express "no overlapping lessons" or "driving lessons need a car".
// Those rules live in prisma/constraints.sql, which you append to the first
// migration (see README, section "Database").

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection string is set in prisma.config.ts.
}

enum StudentStatus {
  active
  paused
  completed
  archived

  @@map("student_status")
}

enum LessonKind {
  driving
  code
  exam

  @@map("lesson_kind")
}

enum LessonStatus {
  scheduled
  completed
  cancelled
  no_show

  @@map("lesson_status")
}

enum Transmission {
  manual
  automatic

  @@map("transmission")
}

model Student {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  phone           String?
  email           String?
  birthDate       DateTime?     @map("birth_date") @db.Date
  /// Sensitive: only ever read inside the admin.
  nationalId      String?       @map("national_id")
  licenceCategory String        @default("B") @map("licence_category")
  status          StudentStatus @default(active)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@map("students")
}

model Instructor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String?
  email      String?
  active     Boolean  @default(true)
  /// Link to the login account once auth exists.
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@map("instructors")
}

model Car {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// For example "Clio blanche".
  label           String
  plate           String       @unique
  transmission    Transmission @default(manual)
  active          Boolean      @default(true)
  nextServiceDate DateTime?    @map("next_service_date") @db.Date
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@map("cars")
}

// Login. These five models are the ones Better Auth needs (https://better-auth.com).
// Only the table and column names are ours; the field names must stay as they are.

/// Someone who can log in to the admin.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// "user" cannot open the dashboard; "admin" can. Set by npm run auth:create-admin.
  role          String    @default("user")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// How a user signs in: "credential" holds the password hash; Google would be another row.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Counts requests per IP address, to slow down password guessing.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Lesson {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  /// Null for code lessons. Required for driving lessons (checked in constraints.sql).
  carId        String?      @map("car_id") @db.Uuid
  kind         LessonKind   @default(driving)
  status       LessonStatus @default(scheduled)
  startsAt     DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime     @map("ends_at") @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    Student    @relation(fields: [studentId], references: [id])
  instructor Instructor @relation(fields: [instructorId], references: [id])
  car        Car?       @relation(fields: [carId], references: [id])

  @@index([startsAt])
  @@map("lessons")
}
